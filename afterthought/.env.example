# Generate secure values; never commit the populated .env file.
POSTGRES_PASSWORD=replace-with-a-url-safe-random-password
SECRET_KEY=replace-with-at-least-32-random-characters
PUBLIC_BASE_URL=https://example.com
CORS_ORIGINS=https://example.com
ALLOWED_HOSTS=example.com,www.example.com,backend
PUBLICATION_TIMEZONE=Asia/Singapore
HTTP_PORT=80

# Optional: creates or promotes this account on backend startup.
BOOTSTRAP_ADMIN_EMAIL=editor@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-12-plus-character-password

# Restrict this to the container network(s) used by your reverse proxy.
FORWARDED_ALLOW_IPS=172.16.0.0/12
